{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // The interop suite reads and writes fixture files, and the ceiling cases
    // read the other implementation's constants out of its source; the package
    // itself stays free of any platform API.
    "types": ["node", "vitest"]
  },
  "include": ["src"],
  "exclude": []
}
