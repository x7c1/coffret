[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
{{!-- StartupWMClass is tauri.conf.json's identifier, written literally: the
window's app ID is the identifier (main.rs sets it as the program name), which
is what GNOME matches here so that it shows one app per identifier. The
template has no variable for it; keep the two equal. --}}
StartupWMClass=io.github.x7c1.coffret
Icon={{icon}}
Name=Coffret
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
